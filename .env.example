# Copy this file to .env (which is gitignored) and fill in the value. Never commit .env.
# AssemblyAI API key — created in the AssemblyAI dashboard after signing up through the
# hackathon's credits link (see docs/SETUP-API-KEY.md).
ASSEMBLYAI_API_KEY=
# Optional, Plan 2: per-session cap in seconds passed to the token mint (60–10800). Default 300.
COUNTERSIGN_SESSION_CAP_SECONDS=300
# Optional founder override: set to "credits" to force /health and /api/session/start to
# report live calls as unavailable (reason credits_exhausted) without a real AssemblyAI
# failure -- lets you rehearse the credits-exhausted replay-mode banner on demand. Leave
# unset otherwise; the server also sets this reason itself on a real mint/connect failure.
COUNTERSIGN_LIVE_DISABLED=
