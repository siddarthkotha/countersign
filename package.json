{
  "name": "countersign",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/web --noEmit && tsc -p packages/server --noEmit",
    "replay": "npm run replay --workspace @countersign/engine --",
    "dev:web": "vite --config packages/web/vite.config.ts packages/web",
    "build:engine": "tsc -p packages/engine/tsconfig.build.json",
    "build:web": "vite build --config packages/web/vite.config.ts packages/web",
    "build:server": "tsc -p packages/server/tsconfig.build.json",
    "build": "npm run build:engine && npm run build:web && npm run build:server",
    "dev:server": "tsx packages/server/src/index.ts",
    "start:server": "node packages/server/dist/index.js",
    "smoke:live": "tsx packages/server/scripts/smoke-live.ts --live",
    "preflight:deploy": "tsx scripts/preflight-deploy.ts",
    "rehearse": "tsx scripts/rehearse/run.ts",
    "rehearse:batch": "tsx scripts/rehearse/rehearseBatch.ts",
    "rehearse:test": "vitest run --config scripts/rehearse/vitest.config.ts",
    "latency:table": "tsx scripts/rehearse/latencyTable.ts",
    "credits:ledger": "tsx scripts/rehearse/creditsLedger.ts",
    "sim:friday": "tsx scripts/rehearse/simFriday.ts",
    "sim:freeplay": "tsx scripts/rehearse/simFreeplay.ts",
    "rehearse:regrade": "tsx scripts/rehearse/regrade.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
