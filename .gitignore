# Agent worktrees (isolated lanes; their diffs land on main as patches, never committed from here)
.claude/worktrees/
# Synthetic-caller rehearsal harness: synthesized clips and per-run reports
scripts/rehearse/.cache/
scripts/rehearse/reports/

# Multi-model critique runner: per-run reports
scripts/critique/reports/
