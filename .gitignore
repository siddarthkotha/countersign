# Secrets — never committed, from the first commit onward
.env
.env.*
*.key
*.key.local
*.pem

# Dependencies / build output
node_modules/
dist/
packages/*/dist/
build/
coverage/

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Claude Code per-session usage ledgers (local telemetry, never submission content)
.claude/session-usage/

# SDD scratch (ledgers, briefs, review packages)
.superpowers/
.claude/autopilot.on
.claude/compaction-log.txt
.claude/worktree-sweep.hold
.claude/worktree-sweep.log
